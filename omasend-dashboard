#!/usr/bin/env bash
DIR="$(cd "$(dirname "$(realpath "$0")")" >/dev/null 2>&1 && pwd)"
clear
echo -e "\033[1;36m=================================================================\033[0m"
echo -e "\033[1;33m  🚀 OMASEND • Yerel Ağ Dosya & Pano Köprüsü \033[0m"
echo -e "\033[1;36m=================================================================\033[0m"
echo ""
echo -e "Lütfen yapmak istediğiniz işlemi seçin:"
echo -e "  \033[1;32m[1]\033[0m 📱 \033[1;37mTelefondan Dosya Al (QR Kod ile Tara & Yükle)\033[0m"
echo -e "  \033[1;34m[2]\033[0m 📤 \033[1;37mBilgisayardan Telefona Dosya Gönder\033[0m"
echo -e "  \033[1;33m[3]\033[0m 📋 \033[1;37mBilgisayarın Panosunu Telefona Gönder\033[0m"
echo -e "  \033[1;35m[4]\033[0m 📶 \033[1;37mBluetooth ile Dosya Gönder\033[0m"
echo -e "  \033[1;31m[q]\033[0m Çıkış"
echo ""
echo -n "Seçiminiz [1/2/3/4/q]: "
read -r CHOICE

LOCAL_IP=$(python3 -c "import socket; s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM); s.connect(('10.255.255.255', 1)); print(s.getsockname()[0]); s.close()")

RUN_DIR="${XDG_RUNTIME_DIR:-/tmp}/omasend_$(id -u)"
mkdir -p "$RUN_DIR"
chmod 700 "$RUN_DIR"
SESSION_LOG="$RUN_DIR/session.log"

if [ "$CHOICE" == "1" ]; then
    clear
    python3 "$DIR/omasend-server" > "$SESSION_LOG" 2>&1 &
    SERVER_PID=$!
    sleep 0.5
    
    TOKEN=$(grep -m1 "TOKEN:" "$SESSION_LOG" | cut -d':' -f2 | tr -d ' \r\n')
    URL="http://${LOCAL_IP}:8844/?k=${TOKEN}"

    echo -e "\033[1;36m=================================================================\033[0m"
    echo -e "\033[1;32m  📱 TELEFONDAN DOSYA ALMA MODU \033[0m"
    echo -e "\033[1;36m=================================================================\033[0m"
    echo ""
    echo -e "🌐 Bağlantı Adresi: \033[1;34m${URL}\033[0m"
    echo -e "📁 Gelen Dosyalar: \033[0;90m~/Downloads/omasend/\033[0m"
    echo ""
    
    qrencode -t ANSIUTF8 "$URL"
    
    echo ""
    echo -e "\033[1;33m[Sunucuyu kapatmak için Ctrl+C'ye basın...]\033[0m"
    
    trap "kill $SERVER_PID 2>/dev/null; rm -f '$SESSION_LOG'; exit 0" SIGINT SIGTERM
    wait $SERVER_PID

elif [ "$CHOICE" == "2" ]; then
    FILE_PATH=""
    if command -v zenity &>/dev/null; then
        FILE_PATH=$(zenity --file-selection --title="Telefona Gönderilecek Dosyayı Seçin" 2>/dev/null || true)
    fi
    if [ -z "$FILE_PATH" ]; then
        echo -n "Dosya yolunu girin: "
        read -r FILE_PATH
        FILE_PATH=$(echo "$FILE_PATH" | tr -d "'\"")
    fi

    if [ -n "$FILE_PATH" ] && [ -f "$FILE_PATH" ]; then
        clear
        python3 "$DIR/omasend-server" "$FILE_PATH" > "$SESSION_LOG" 2>&1 &
        SERVER_PID=$!
        sleep 0.5
        TOKEN=$(grep -m1 "TOKEN:" "$SESSION_LOG" | cut -d':' -f2 | tr -d ' \r\n')
        URL="http://${LOCAL_IP}:8844/?k=${TOKEN}"

        echo -e "\033[1;36m=================================================================\033[0m"
        echo -e "\033[1;34m  📤 BİLGİSAYARDAN DOSYA GÖNDERME MODU \033[0m"
        echo -e "\033[1;36m=================================================================\033[0m"
        echo ""
        echo -e "📦 Paylaşılan: \033[1;37m$(basename "$FILE_PATH")\033[0m"
        echo -e "🌐 İndirme Adresi: \033[1;34m${URL}\033[0m"
        echo ""
        qrencode -t ANSIUTF8 "$URL"
        echo ""
        echo -e "\033[1;33m[İndirme tamamlanınca çıkmak için Ctrl+C'ye basın...]\033[0m"
        
        trap "kill $SERVER_PID 2>/dev/null; rm -f '$SESSION_LOG'; exit 0" SIGINT SIGTERM
        wait $SERVER_PID
    fi

elif [ "$CHOICE" == "3" ]; then
    clear
    CLIP_TEXT=$(wl-paste 2>/dev/null || true)
    echo -e "\033[1;36m=================================================================\033[0m"
    echo -e "\033[1;33m  📋 BİLGİSAYARIN PANOSUNU TELEFONA GÖNDER \033[0m"
    echo -e "\033[1;36m=================================================================\033[0m"
    echo ""
    if [ -z "$CLIP_TEXT" ]; then
        echo -e "\033[1;31m⚠️ Bilgisayarınızın panosu boş!\033[0m"
    else
        echo -e "📄 \033[1;32mPanodaki Metin:\033[0m"
        echo "$CLIP_TEXT" | head -n 4
        [ $(echo "$CLIP_TEXT" | wc -l) -gt 4 ] && echo "..."
        echo ""
        qrencode -t ANSIUTF8 "$CLIP_TEXT"
    fi
    echo ""
    echo -e "\033[0;90mKapatmak için bir tuşa basın...\033[0m"
    read -n 1 -s -r

elif [ "$CHOICE" == "4" ]; then
    if command -v bluetooth-sendto &>/dev/null; then
        bluetooth-sendto
    elif command -v blueman-sendto &>/dev/null; then
        blueman-sendto
    else
        omarchy-launch-floating-terminal-with-presentation "bluetoothctl"
    fi
fi
