#!/usr/bin/env bash
set -euo pipefail

# Prefer native Quickshell UI if available
if [[ "${1:-}" != "--cli" ]] && command -v quickshell >/dev/null 2>&1; then
    if quickshell ipc -p /usr/share/omarchy/shell call ozdil.omasend toggle >/dev/null 2>&1; then
        exit 0
    fi
fi

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BIN="${DIR}/omasend-engine"

if [[ ! -x "${BIN}" ]]; then
    if [[ -f "${DIR}/target/release/omasend-engine" ]]; then
        install -m 755 "${DIR}/target/release/omasend-engine" "${BIN}"
    elif command -v cargo >/dev/null 2>&1 && [[ -f "${DIR}/Cargo.toml" ]]; then
        echo "Building omasend-engine from source..."
        (cd "${DIR}" && cargo build --release --locked && install -m 755 target/release/omasend-engine "${BIN}") || true
    fi
fi

if [[ -x "${BIN}" ]]; then
    clear
    "${BIN}"
    echo ""
    read -r -p "Press Enter to exit..." || true
else
    echo "Engine binary not found. Please run 'cargo build --release --locked && cp target/release/omasend-engine .' in ${DIR}"
    exit 1
fi
