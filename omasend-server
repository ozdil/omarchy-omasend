def get_local_ip():
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        s.connect(('10.255.255.255', 1))
        IP = s.getsockname()[0]
    except Exception:
        IP = '127.0.0.1'
    finally:
        s.close()
    return IP

def get_pc_clipboard():
    try:
        res = subprocess.run(['wl-paste', '--no-newline'], capture_output=True, text=True, timeout=1)
        return res.stdout
    except Exception:
        return ""

def set_pc_clipboard(text):
    try:
        p = subprocess.Popen(['wl-copy'], stdin=subprocess.PIPE, text=True)
        p.communicate(input=text)
        # Send desktop notification
        preview = text[:40] + ('...' if len(text) > 40 else '')
        subprocess.run(['notify-send', '🚀 omasend • Pano Güncellendi', f'Mobilden kopyalandı: {preview}'], check=False)
        return True
    except Exception:
        return False

