FORBIDDEN_PAGE = """<!DOCTYPE html>
<html>
<head><title>403 - Yetkisiz Erişim</title><meta charset="utf-8"></head>
<body style="background:#080c14;color:#f87171;display:flex;align-items:center;justify-content:center;height:100vh;font-family:sans-serif;text-align:center;">
  <div>
    <h2>🔒 403 - Yetkisiz Giriş Engellendi</h2>
    <p style="color:#94a3b8;margin-top:8px;">Lütfen bilgisayar ekranındaki QR kodu telefonunuzla okutun.</p>
  </div>
</body>
</html>"""

class OmasendHandler(http.server.BaseHTTPRequestHandler):
    def log_message(self, format, *args):
        pass

    def check_auth(self, parsed):
        qs = urllib.parse.parse_qs(parsed.query)
        token = qs.get("k", [""])[0]
        return token == SESSION_TOKEN

    def send_forbidden(self):
        self.send_response(403)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        content = FORBIDDEN_PAGE.encode("utf-8")
        self.send_header("Content-Length", str(len(content)))
        self.end_headers()
        self.wfile.write(content)

    def do_HEAD(self):
        self.do_GET()

    def do_GET(self):
        parsed = urllib.parse.urlparse(self.path)
        
        if not self.check_auth(parsed):
            self.send_forbidden()
            return

        if parsed.path == "/" or parsed.path == "/index.html":
            download_section = ""
            if SHARED_FILE and os.path.isfile(SHARED_FILE) and not os.path.islink(SHARED_FILE):
                filename = os.path.basename(SHARED_FILE)
                filesize = round(os.path.getsize(SHARED_FILE) / 1024 / 1024, 2)
                clean_fn = sanitize_filename(filename)
                download_section = f"""
                <div class="card">
                  <div class="card-title">💻 ➔ 📱 Bilgisayardan Dosya İndir</div>
                  <a href="/download/{urllib.parse.quote(clean_fn)}?k={SESSION_TOKEN}" style="display:flex; justify-content:space-between; width:100%; background:#0f172a; color:#38bdf8; text-decoration:none; padding:12px; border-radius:8px; border:1px solid #0284c7; font-weight:600; font-size:13px;">
                    <span>📥 {clean_fn} ({filesize} MB)</span>
                    <span>İndir ⬇️</span>
                  </a>
                </div>
                """
            
            content = HTML_PAGE.replace("__DOWNLOAD_SECTION__", download_section).replace("__SESSION_TOKEN__", SESSION_TOKEN).encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(content)))
            self.end_headers()
            self.wfile.write(content)
            return

        elif parsed.path == "/api/clipboard":
            clip = get_pc_clipboard()
            data = json.dumps({"clipboard": clip}).encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(data)))
            self.end_headers()
            self.wfile.write(data)
            return

        elif parsed.path.startswith("/download/"):
            if SHARED_FILE and os.path.isfile(SHARED_FILE) and not os.path.islink(SHARED_FILE):
                filename = sanitize_filename(os.path.basename(SHARED_FILE))
                self.send_response(200)
                self.send_header("Content-Type", "application/octet-stream")
                self.send_header("Content-Disposition", f'attachment; filename="{filename}"')
                self.send_header("Content-Length", str(os.path.getsize(SHARED_FILE)))
                self.end_headers()
                with open(SHARED_FILE, "rb") as f:
                    while chunk := f.read(65536):
                        self.wfile.write(chunk)
                return

        self.send_error(404, "Not found")

    def do_POST(self):
        parsed = urllib.parse.urlparse(self.path)
        if not self.check_auth(parsed):
            self.send_forbidden()
            return

        if parsed.path == "/api/clipboard":
            content_length = int(self.headers.get('Content-Length', 0))
            if content_length > MAX_CLIPBOARD_CHARS * 2:
                self.send_error(413, "Payload Too Large")
                return
            body = self.rfile.read(content_length).decode('utf-8', errors='ignore')
            try:
                data = json.loads(body)
                text = data.get("text", "")
                if text:
                    set_pc_clipboard(text)
                self.send_response(200)
                self.send_header("Content-Type", "application/json")
                self.end_headers()
                self.wfile.write(b'{"status": "ok"}')
            except Exception as e:
                self.send_error(500, str(e))
            return

        elif parsed.path == "/upload":
            content_type = self.headers.get("Content-Type", "")
            content_length = int(self.headers.get('Content-Length', 0))
            if content_length > MAX_UPLOAD_BYTES:
                self.send_error(413, "Dosya boyutu çok büyük (Maks 100MB)")
                return
            if not content_type or "multipart/form-data" not in content_type:
                self.send_error(400, "Bad Request")
                return

            try:
                body_bytes = self.rfile.read(content_length)
                msg_bytes = f"Content-Type: {content_type}\r\n\r\n".encode("utf-8") + body_bytes
                msg = email.parser.BytesParser(policy=email.policy.default).parsebytes(msg_bytes)

                saved_count = 0
                for part in msg.iter_parts():
                    filename = part.get_filename()
                    if filename:
                        safe_name = sanitize_filename(filename)
                        out_path = os.path.join(DOWNLOAD_DIR, safe_name)
                        
                        base, ext = os.path.splitext(safe_name)
                        counter = 1
                        while os.path.exists(out_path):
                            out_path = os.path.join(DOWNLOAD_DIR, f"{base}_{counter}{ext}")
                            counter += 1

                        with open(out_path, 'wb') as f:
                            f.write(part.get_payload(decode=True))
                        saved_count += 1
                        print(f"📥 [omasend] Alındı: {out_path}", flush=True)

                self.send_response(200)
                self.send_header("Content-Type", "text/plain; charset=utf-8")
                self.end_headers()
                self.wfile.write(f"OK ({saved_count} dosya kaydedildi)".encode("utf-8"))
            except Exception as e:
                self.send_error(500, str(e))

def start_server():
    socketserver.TCPServer.allow_reuse_address = True
    with socketserver.ThreadingTCPServer(("0.0.0.0", PORT), OmasendHandler) as httpd:
        local_ip = get_local_ip()
        print(f"TOKEN:{SESSION_TOKEN}", flush=True)
        print(f"URL:http://{local_ip}:{PORT}/?k={SESSION_TOKEN}", flush=True)
        try:
            httpd.serve_forever()
        except KeyboardInterrupt:
            pass

if __name__ == "__main__":
    start_server()
