def get_local_ip():
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        s.connect(('10.255.255.255', 1))
        IP = s.getsockname()[0]
    except Exception:
        IP = '127.0.0.1'
    finally:
        s.close()
    return IP

def sanitize_str(s, max_len=80):
    return re.sub(r'[\x00-\x1f\x7f-\x9f]', '', str(s))[:max_len]

def sanitize_filename(filename):
    clean = os.path.basename(filename).replace("..", "").replace("/", "").replace("\\", "").strip()
    clean = re.sub(r'[^a-zA-Z0-9_.-]', '_', clean)
    return clean[:60] if clean else f"file_{secrets.token_hex(4)}.dat"

def get_pc_clipboard():
    try:
        res = subprocess.run(['wl-paste', '--no-newline'], capture_output=True, text=True, timeout=1.0)
        return res.stdout[:MAX_CLIPBOARD_CHARS]
    except Exception:
        return ""

def set_pc_clipboard(text):
    try:
        clean_text = text[:MAX_CLIPBOARD_CHARS]
        p = subprocess.Popen(['wl-copy'], stdin=subprocess.PIPE, text=True)
        p.communicate(input=clean_text)
        preview = clean_text[:35] + ('...' if len(clean_text) > 35 else '')
        subprocess.run(['notify-send', '🚀 omasend • Pano Güncellendi', f'Alınan: {sanitize_str(preview)}'], check=False)
        return True
    except Exception:
        return False

