#!/usr/bin/env bash
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BIN="${DIR}/omasend-engine"

if [[ ! -x "${BIN}" ]]; then
    if [[ -f "${DIR}/target/release/omasend-engine" ]]; then
        cp "${DIR}/target/release/omasend-engine" "${BIN}"
        chmod +x "${BIN}"
    elif command -v cargo >/dev/null 2>&1 && [[ -f "${DIR}/Cargo.toml" ]]; then
        (cd "${DIR}" && cargo build --release --locked && cp target/release/omasend-engine "${BIN}" && chmod +x "${BIN}") >/dev/null 2>&1 || true
    fi
fi

if [[ -x "${BIN}" ]]; then
    exec "${BIN}" --status
else
    echo '{"text":"OMASEND: OFFLINE","tooltip":"Engine binary not found (run cargo build --release)","class":"alert"}'
fi
